{
  "name": "finance-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.ts,.vue",
    "format": "prettier --write src/",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest",
    "test:components": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:local": "cross-env E2E_BASE_URL=https://localhost:5173 playwright test",
    "test:e2e:local:ui": "cross-env E2E_BASE_URL=https://localhost:5173 playwright test --ui",
    "test:e2e:local:headed": "cross-env E2E_BASE_URL=https://localhost:5173 playwright test --headed"
  },
  "dependencies": {
    "@internationalized/date": "^3.10.0",
    "@lucide/vue": "^1.66.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vueuse/core": "^14.0.0",
    "axios": "^1.12.2",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "oidc-client-ts": "^3.5.0",
    "pinia": "^3.0.3",
    "recharts": "^3.5.1",
    "reka-ui": "^2.6.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.49.1",
    "@types/node": "^24.7.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
