# Copy to .env and export, or set in your shell.
# 32-byte AES key, base64. Generate one with: uv run python manage.py generate_key
SECURITY_ENCRYPTION_KEY_BASE64=
# Alternatively point to a JSON file {"keyBase64": "..."} (default: .env.d/encryptionKey64.json)
SECURITY_ENCRYPTION_KEY_FILE=
CORS_ALLOWED_ORIGINS=http://localhost:5173
