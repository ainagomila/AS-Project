# Copy to .env and export, or set in your shell.
# DJANGO_DEBUG=1 gives development defaults for the secret key and DB password.
DJANGO_DEBUG=
# Required when DJANGO_DEBUG is off. Generate with: openssl rand -base64 48
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],backend
# Seconds of HSTS (default 1 year when DJANGO_DEBUG is off, 0 in debug mode)
DJANGO_HSTS_SECONDS=

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=kofredb
POSTGRES_USER=user
POSTGRES_PASSWORD=

# 32-byte AES key, base64. Generate one with: uv run python manage.py generate_key
SECURITY_ENCRYPTION_KEY_BASE64=
# Alternatively point to a JSON file {"keyBase64": "..."} (default: .env.d/encryptionKey64.json)
SECURITY_ENCRYPTION_KEY_FILE=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# RSA private key for OIDC (PEM). Default: file .env.d/oidc.key
# Generate: openssl genrsa -out .env.d/oidc.key 2048
OIDC_RSA_PRIVATE_KEY_FILE=
OIDC_RSA_PRIVATE_KEY=

# Base URL of the Vue app. The OAuth client's redirect URI is FRONTEND_URL + /callback
# (create it with: uv run python manage.py create_oauth_client)
FRONTEND_URL=https://localhost:5173
